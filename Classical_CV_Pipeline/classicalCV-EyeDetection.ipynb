   "outputs": [],
   "source": [
    "import cv2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "abc4b6ac-2295-45a1-a238-41fa01d79522",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Load image\n",
    "img = cv2.imread(\"r1.jpg\")\n",
    "\n",
    "# 2. Convert to grayscale\n",
    "gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
    "\n",
    "# 3. Load Haar Cascade XML files\n",
    "face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + \"haarcascade_frontalface_default.xml\")\n",
    "eye_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + \"haarcascade_eye_tree_eyeglasses.xml\")\n",
    "\n",
    "# 4. Detect faces\n",
    "faces = face_cascade.detectMultiScale(gray, scaleFactor=1.3, minNeighbors=5, minSize=(50, 50))\n",
    "\n",
    "# 5. Draw rectangle on faces\n",
    "for (x, y, w, h) in faces:\n",
    "    cv2.rectangle(img, (x, y), (x+w, y+h), (255, 0, 0), 2)\n",
    "\n",
    "    # 6. Region of Interest (ROI) for eyes\n",
    "    roi_gray = gray[y:y+h, x:x+w]\n",
    "    roi_color = img[y:y+h, x:x+w]\n",
    "\n",
    "    # Detect eyes inside face\n",
    "    eyes = eye_cascade.detectMultiScale(roi_gray)\n",
    "\n",
    "    # 7. Draw circles on eyes\n",
    "    for (ex, ey, ew, eh) in eyes:\n",
    "        center = (ex + ew//2, ey + eh//2)\n",
    "        radius = ew // 2\n",
    "        cv2.circle(roi_color, center, radius, (0, 255, 0), 2)\n",
    "\n",
    "# 8. Display output\n",
    "cv2.imshow(\"Face and Eye Detection\", img)\n",
    "cv2.waitKey(0)\n",
    "cv2.destroyAllWindows()"
   ]
  }
